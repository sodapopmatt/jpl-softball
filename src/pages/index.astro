---
import Layout from '../layouts/Layout.astro';
import leagues from '../data/leagues.json';
import teams from '../data/teams.json';
import schedule from '../data/schedule.json';
import seasons from '../data/seasons.json';
import { parseLocalDate, formatGameDate } from '../utils/date.js';

const teamById = Object.fromEntries(teams.map((t) => [t.id, t]));
const leagueById = Object.fromEntries(leagues.map((l) => [l.id, l]));
const currentSeasonIds = new Set(seasons.filter((s) => s.current).map((s) => s.id));

const today = new Date();
today.setHours(0, 0, 0, 0);
const upcoming = schedule
  .filter((g) => currentSeasonIds.has(g.season) && parseLocalDate(g.date) >= today)
  .sort((a, b) => parseLocalDate(a.date) - parseLocalDate(b.date))
  .slice(0, 3);
---
<Layout title="Home">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-league-red/10 via-neutral-50 to-neutral-50"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
      <p class="font-display text-league-red tracking-[0.3em] text-sm mb-4">B LEAGUE &amp; C LEAGUE</p>
      <h1 class="font-display text-4xl sm:text-6xl font-bold leading-tight max-w-2xl">
        JPL Softball League
      </h1>
      <p class="mt-4 max-w-xl text-neutral-700 text-lg">
        Two leagues, open to JPL/Caltech employees, contractors, and their immediate families. Check the schedule, see where your team stands, and never miss a game.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/schedule" class="rounded-full bg-league-red text-white px-6 py-3 font-semibold hover:bg-red-500 transition-colors">
          View Schedule
        </a>
        <a href="/register" class="rounded-full border border-neutral-300 px-6 py-3 font-semibold hover:bg-neutral-100 transition-colors">
          Register a Team
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="font-display text-2xl font-bold">Up Next</h2>
      <a href="/schedule" class="text-sm text-league-red hover:underline">Full schedule →</a>
    </div>
    <div class="grid sm:grid-cols-3 gap-4">
      {upcoming.map((game) => (
        <div class="rounded-2xl bg-white border border-neutral-200 p-5 hover:border-league-red/40 transition-colors">
          <p class="text-xs uppercase tracking-wide text-neutral-600 mb-3">
            {leagueById[game.league].name} · {formatGameDate(game.date)} · {game.time}
          </p>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full" style={`background:${teamById[game.away].color}`}></span>
              <span class="font-medium">{teamById[game.away].name}</span>
            </div>
            <span class="text-neutral-500 text-sm">@</span>
            <div class="flex items-center gap-2">
              <span class="font-medium">{teamById[game.home].name}</span>
              <span class="w-2.5 h-2.5 rounded-full" style={`background:${teamById[game.home].color}`}></span>
            </div>
          </div>
          <p class="mt-3 text-sm text-neutral-600">{game.field}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <h2 class="font-display text-2xl font-bold mb-6">Leagues</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {leagues.map((league) => (
        <a
          href={`/schedule/${league.id.toLowerCase()}`}
          class="rounded-2xl bg-white border border-neutral-200 p-6 hover:border-league-red/40 transition-colors"
        >
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-display text-xl font-bold">{league.name}</h3>
            <span class="text-xs uppercase tracking-wide text-neutral-500">{league.tagline}</span>
          </div>
          <p class="text-sm text-neutral-600 mb-3">{league.field}</p>
          <p class="text-sm text-league-red">View {league.name} schedule →</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
