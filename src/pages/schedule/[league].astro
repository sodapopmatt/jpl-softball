---
import Layout from '../../layouts/Layout.astro';
import leagues from '../../data/leagues.json';
import teams from '../../data/teams.json';
import schedule from '../../data/schedule.json';
import seasons from '../../data/seasons.json';
import ScheduleView from '../../components/ScheduleView.astro';
import { seasonsForLeague, currentSeason } from '../../utils/season.js';

export function getStaticPaths() {
  return leagues.map((l) => ({
    params: { league: l.id.toLowerCase() },
    props: { league: l },
  }));
}

const { league } = Astro.props;
const teamById = Object.fromEntries(teams.map((t) => [t.id, t]));
const season = currentSeason(seasons, league.id);
const leagueSeasons = seasonsForLeague(seasons, league.id);
const games = schedule.filter((g) => g.season === season.id);
---
<Layout title={`${league.name} Schedule`}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <ScheduleView league={league} season={season} seasons={leagueSeasons} games={games} teamById={teamById} />
  </section>
</Layout>
