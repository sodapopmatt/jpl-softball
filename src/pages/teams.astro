---
import Layout from '../layouts/Layout.astro';
import leagues from '../data/leagues.json';
import teams from '../data/teams.json';
---
<Layout title="Teams">
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="font-display text-3xl sm:text-4xl font-bold mb-8">Teams</h1>

    {leagues.map((league) => (
      <div class="mb-12">
        <h2 class="font-display text-2xl font-bold mb-6">{league.name}</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          {teams.filter((t) => t.league === league.id).map((team) => (
            <a href={`/teams/${team.id}`} id={team.id} class="rounded-2xl bg-white border border-neutral-200 p-6 scroll-mt-24 hover:border-league-red/40 transition-colors">
              <div class="flex items-center gap-3 mb-3">
                {team.logo ? (
                  <img src={team.logo} alt="" class="w-8 h-8 rounded-full object-cover" />
                ) : (
                  <span class="w-8 h-8 rounded-full" style={`background:${team.color}`}></span>
                )}
                <h3 class="font-display text-xl font-bold">{team.name}</h3>
              </div>
              <p class="text-sm text-neutral-600">Manager: {team.manager || 'TBD'}{team.managerPhone ? ` (${team.managerPhone})` : ''}</p>
              {team.asstManager && (
                <p class="text-sm text-neutral-600">Asst. Manager: {team.asstManager}{team.asstManagerPhone ? ` (${team.asstManagerPhone})` : ''}</p>
              )}
              <p class="text-sm text-league-red mt-3">View team page →</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
