---
import Layout from '../../layouts/Layout.astro';
import teams from '../../data/teams.json';
import leagues from '../../data/leagues.json';

export function getStaticPaths() {
  return teams.map((t) => ({
    params: { team: t.id },
    props: { team: t },
  }));
}

const { team } = Astro.props;
const league = leagues.find((l) => l.id === team.league);
const initials =
  team.abbr ||
  team.name
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 3)
    .toUpperCase();
---
<Layout title={team.name}>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <p class="text-sm mb-2">
      <a href="/teams" class="text-league-red hover:underline">← All teams</a>
    </p>

    <div class="flex items-center gap-5 mb-8">
      {team.logo ? (
        <img src={team.logo} alt={`${team.name} logo`} class="w-20 h-20 rounded-2xl object-cover border border-neutral-200" />
      ) : (
        <div
          class="w-20 h-20 rounded-2xl flex items-center justify-center border border-neutral-200 font-display text-xl font-bold text-white"
          style={`background:${team.color}`}
          title="No logo uploaded yet"
        >
          {initials}
        </div>
      )}
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-3 h-3 rounded-full" style={`background:${team.color}`}></span>
          <span class="text-xs uppercase tracking-wide text-neutral-500">{league?.name}</span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl font-bold">{team.name}</h1>
      </div>
    </div>

    {!team.logo && (
      <p class="text-xs text-neutral-500 mb-8 -mt-4">
        No team logo yet — drop an image in <code class="text-neutral-600">public/team-logos/{team.id}.png</code> and set this team's <code class="text-neutral-600">logo</code> field in <code class="text-neutral-600">teams.json</code> to <code class="text-neutral-600">/team-logos/{team.id}.png</code>.
      </p>
    )}

    <div class="rounded-2xl bg-white border border-neutral-200 p-6 mb-6">
      <h2 class="font-display text-lg font-semibold text-league-red mb-4">Management</h2>
      <div class="grid sm:grid-cols-2 gap-4 text-sm">
        <div>
          <p class="text-neutral-500 uppercase text-xs tracking-wide mb-1">Manager</p>
          <p class="font-medium">{team.manager || 'TBD'}</p>
          {team.managerPhone && <p class="text-neutral-600">{team.managerPhone}</p>}
        </div>
        {team.asstManager && (
          <div>
            <p class="text-neutral-500 uppercase text-xs tracking-wide mb-1">Asst. Manager</p>
            <p class="font-medium">{team.asstManager}</p>
            {team.asstManagerPhone && <p class="text-neutral-600">{team.asstManagerPhone}</p>}
          </div>
        )}
      </div>
    </div>

    <div class="rounded-2xl bg-white border border-neutral-200 p-6">
      <h2 class="font-display text-lg font-semibold text-league-red mb-4">Roster</h2>
      {team.roster && team.roster.length > 0 ? (
        <ul class="grid sm:grid-cols-2 gap-2 text-sm text-neutral-700">
          {team.roster.map((player) => (
            <li class="rounded-lg bg-neutral-50 border border-neutral-200 px-3 py-2">{player}</li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-neutral-500">
          Roster not posted yet. Add player names to this team's <code class="text-neutral-600">roster</code> array in <code class="text-neutral-600">teams.json</code>.
        </p>
      )}
    </div>
  </section>
</Layout>
