---
import { formatGameDate } from '../utils/date.js';

const { game, teamById } = Astro.props;
const played = game.homeScore !== null && game.awayScore !== null;
---
<div class="rounded-xl bg-white border border-neutral-200 p-4">
  <div class="flex items-center justify-between gap-3 mb-3 pb-3 border-b border-neutral-100">
    <p class="font-semibold text-sm text-neutral-900">{formatGameDate(game.date)}</p>
    <p class="text-xs text-neutral-500 text-right">{game.time}<br class="sm:hidden" /><span class="hidden sm:inline"> · </span>{game.field}</p>
  </div>
  <div class="flex items-center gap-3 font-medium flex-wrap">
    <span class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full" style={`background:${teamById[game.away].color}`}></span>
      {teamById[game.away].name}
    </span>
    <span class="text-neutral-500 text-sm">
      {played
        ? `${game.awayScore} – ${game.homeScore}`
        : game.winner
          ? `${teamById[game.winner].abbr || teamById[game.winner].name} won`
          : '@'}
    </span>
    <span class="flex items-center gap-2">
      {teamById[game.home].name}
      <span class="w-2.5 h-2.5 rounded-full" style={`background:${teamById[game.home].color}`}></span>
    </span>
  </div>
</div>
